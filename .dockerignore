apps/*/dist
apps/*/storage
.git
.gitignore
*.log
logs
coverage
.env
jiword_config.txt
jitword-integration/config/config.local.json
backups
jitarchives-backup-*
*.db
*.db-wal
*.db-shm
*.db-journal
Dockerfile
docker-compose.yml
.dockerignore
